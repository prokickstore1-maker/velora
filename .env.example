# =========================================
# Myvelora Store — Environment Variables
# =========================================

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/myvelorastore"

# Admin Authentication
ADMIN_PASSWORD_HASH=""
ADMIN_SESSION_SECRET="myvelora-admin-session-secret-change-in-production-min32"

# S3 / MinIO Object Storage
S3_ENDPOINT="https://s3.ap-southeast-1.amazonaws.com"
S3_REGION="ap-southeast-1"
S3_BUCKET="myvelora-assets"
S3_ACCESS_KEY_ID="your-access-key-id"
S3_SECRET_ACCESS_KEY="your-secret-access-key"
S3_PUBLIC_BASE_URL="https://myvelora-assets.s3.ap-southeast-1.amazonaws.com"
S3_FORCE_PATH_STYLE="false" # set to "true" for MinIO or self-hosted S3

# Notifications (Optional fallback env; storeSettings DB also supports dynamic config)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
